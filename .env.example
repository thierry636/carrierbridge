# Canonical site URL — used for canonical tags, hreflang, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://carrier-bridge.com

# Where the "Commencer" / "Comparer mes grilles gratuitement" buttons point.
NEXT_PUBLIC_APP_URL=https://app.carrier-bridge.com

# Demo video, embedded click-to-load. A YouTube, Vimeo or Loom URL as copied
# from the address bar. Empty = the poster shows without a play button.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Plausible site domain. Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=carrier-bridge.com

# Resend (https://resend.com). Without a key the contact form accepts the
# request and logs a warning instead of sending — convenient in development.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=CarrierBridge <contact@carrier-bridge.com>
CONTACT_TO_EMAIL=contact@carrier-bridge.com
